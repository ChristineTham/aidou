# Quarto build artefacts
quarto/_book/
quarto/.quarto/
quarto/site_libs/
# generated Typst (from keep-typ); source is index.qmd
quarto/index.typ
# generated per-doc figure dirs (Mermaid PNGs, etc.)
quarto/*_files/
# generated landing partials (sources: book/blurb.md, book/epigraph.md)
quarto/_blurb.md
quarto/_blurb.typ
quarto/_blurb.json
quarto/_epigraph.md
quarto/_seo.html
# art copied in from images/ at build time (source of truth: images/)
quarto/cover.png
quarto/ogimage.jpg
quarto/chapter-art/
quarto/projects/
quarto/illustrations/
# generated design tokens (source: theme.yml)
quarto/_brand.yml
quarto/_tokens.scss
quarto/_tokens.css
quarto/_tokens.typ
quarto/_tokens.json

# Generated chapter pages — produced from book/*.md by the pre-render hook.
# index.qmd is hand-authored and kept; the rest are ephemeral.
quarto/*.qmd
!quarto/index.qmd

# Skill-development eval scratch (skill-creator workspaces)
.agents/skills/*-workspace/

# OS / editor cruft
.DS_Store
